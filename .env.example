# The Odds API - Sign up at https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# BallDontLie PGA API - Sign up at https://pga.balldontlie.io
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# Data Golf API - Sign up at https://datagolf.com/api-access
# This is the PRIMARY data source for predictions, odds, and strokes-gained
DATAGOLF_API_KEY=your_datagolf_api_key_here

# Shopify Admin API - only needed for scripts/deploy_to_shopify.py (--deploy)
# Create a custom app: Shopify admin -> Settings -> Apps and sales channels ->
# Develop apps -> Create an app -> Admin API scopes: read_content + write_content ->
# Install app -> reveal Admin API access token (starts with shpat_)
# NOTE: This is separate from the Claude Shopify plugin (OAuth, lives in Claude, not here).
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_api_token_here

# Sinch RCS - only needed to actually SEND the branded RCS preview
# (scripts/send_rcs_preview.py --send). The --dry-run preview needs none of these.
# 1) Create a free Sinch account -> RCS -> create an agent named "Golf in the Cosmos"
#    (upload the COSMOS logo + brand color); this registers the agent under Sinch
#    (a Google RCS partner) so branded messages can originate.
# 2) Add your phone + crew as TEST DEVICES and accept the invite on each (Android,
#    RCS enabled). Messages to registered test devices are free.
# 3) Paste the agent's bot id + access token below. Region is your agent's region.
SINCH_RCS_BOT_ID=your_sinch_rcs_agent_bot_id
SINCH_RCS_TOKEN=your_sinch_rcs_access_token
SINCH_RCS_REGION=us

# Database Configuration (optional - not yet implemented)
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cosmos_golf
# For SQLite:
# DATABASE_URL=sqlite:///./cosmos_golf.db

# Database Pool Settings (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
